# Pin the default npm registry to the public registry.
#
# Required by Dependabot: its npm updater auto-injects a GitHub Packages
# credential (npm.pkg.github.com) whenever the update job is granted
# `Packages: read`, then refuses to fetch files unless the project declares a
# registry via a committed .npmrc or a `registries:` block in dependabot.yml
# (error: private_registry_config_not_found). This project resolves every
# dependency from the public registry, so we declare that explicitly here.
registry=https://registry.npmjs.org/
