# Placeholder values only — copy to .env.local (gitignored) and fill in real secrets.

NEXT_PUBLIC_SUPABASE_URL= # Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY= # Server-only secret; bypasses RLS for video uploads. NEVER prefix with NEXT_PUBLIC_.
ADMIN_EMAIL= # the only email allowed to sign in to /admin
NEXT_PUBLIC_SITE_URL= # canonical production origin, e.g. https://your-domain.com (used by sitemap, robots, and OG/canonical metadata)
SITE_PASSWORD= # Optional: when set, the WHOLE site is locked behind HTTP Basic Auth (user "admin", this password). Leave empty for local/public; set it for private preview deploys.
